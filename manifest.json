{
  "manifest_version": 3,
  "name": "Gemini Live 同時通訳",
  "version": "1.0.0",
  "description": "開いているタブの音声を Gemini 3.5 Live Translate でリアルタイムに日本語へ翻訳し、カラオケ字幕で表示します。",
  "permissions": ["tabCapture", "storage", "activeTab"],
  "action": {
    "default_title": "このタブを同時通訳"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
